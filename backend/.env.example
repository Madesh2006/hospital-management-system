# ===== Database =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hospital_management

# Full SQLAlchemy URL is built from the above, but you can override it directly:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/hospital_management

# ===== JWT Auth =====
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== App =====
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# ===== Email (for forgot-password / notifications) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=City Care Hospital
